# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env.local BEFORE RUNNING THE APPLICATION:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY WARNING:
# Never commit .env or .env.local files containing real API secrets to version control.
# .env.local is ignored in .gitignore to protect your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API
# ------------------------------------------------------------------------------
# Required for real-time speech evaluation, STAR framework coaching,
# and tailored interview question generation.
# Generate a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Supabase Database Configuration
# ------------------------------------------------------------------------------
# Required for storing session analytics, transcripts, and dimensions.
# Retrieve from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supabase Service Role Key (Used for administrative server tasks)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# Optional App Settings
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
